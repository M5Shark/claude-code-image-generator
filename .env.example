# Copy this file to .env to change settings. Nothing is required for the default setup:
# it uses Codex inside the ChatGPT app, signed in with your ChatGPT account.

# Where images are saved
# IMAGE_OUTPUT_DIR=~/Pictures/ChatGPT Images
# Preview size sent back to Claude (0 = no preview)
# IMAGE_PREVIEW_MAX_PX=768

# --- ChatGPT login backend (default) ---
# CODEX_PATH=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=low
# CODEX_TIMEOUT=600

# --- OpenAI API backend (optional, pay per image) ---
# IMAGE_BACKEND=api
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
